{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop catalog (assistant)",
    "version": "1.0.0",
    "description": "Read-only catalog endpoints for product discovery."
  },
  "servers": [{ "url": "http://internal" }],
  "paths": {
    "/products/categories": {
      "get": {
        "operationId": "list_product_categories",
        "summary": "List all product categories (name and url slug).",
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "slug": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "search_products",
        "summary": "Search and filter active products in the catalog.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search product name and description.",
            "schema": { "type": "string", "maxLength": 200 }
          },
          {
            "name": "category_slug",
            "in": "query",
            "description": "Filter by category slug from list_product_categories.",
            "schema": { "type": "string" }
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["id", "price_asc", "price_desc", "name"],
              "default": "id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (1–50).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor from a previous search_products response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Product page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array" },
                    "next_cursor": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/slug/{slug}": {
      "get": {
        "operationId": "get_product_by_slug",
        "summary": "Get one product's full details by its url slug.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    }
  }
}