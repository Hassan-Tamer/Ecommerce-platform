# Local Ubuntu: peer auth as your Linux user (no password)
DATABASE_URL=postgresql+psycopg:///@/ecommerce?host=/var/run/postgresql

# Or TCP + password (set postgres password to match):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ecommerce

JWT_SECRET_KEY=change-me-to-a-long-random-string

# Redis (rate limiting + catalog cache)
# REDIS_URL=redis://127.0.0.1:6379/0
# CATALOG_PRODUCT_SLUG_TTL_SECONDS=300
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# MinIO (S3 API on host :9001, web console :9002 — see README docker run)
MINIO_ENDPOINT=http://127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-root-password
MINIO_BUCKET=product-images
MINIO_USE_SSL=false