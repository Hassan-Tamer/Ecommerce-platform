# Local Ubuntu: peer auth as your Linux user (no password)
DATABASE_URL=postgresql+psycopg:///@/ecommerce?host=/var/run/postgresql

# Or TCP + password (set postgres password to match):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ecommerce

JWT_SECRET_KEY=change-me-to-a-long-random-string

# Redis (rate limiting + catalog cache)
# REDIS_URL=redis://127.0.0.1:6379/0

# Celery beat deletes carts last updated more than 7 days ago, daily at 01:25.
# Broker uses Redis logical DB 1. Task results use DB 2.
# Timezone defaults to the host zone (else UTC).
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# CELERY_TIMEZONE=Africa/Cairo
# CATALOG_PRODUCT_SLUG_TTL_SECONDS=300
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# MinIO (S3 API on host :9001, web console :9002 — see README docker run)
MINIO_ENDPOINT=http://127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-root-password
MINIO_BUCKET=product-images
MINIO_USE_SSL=false
# Optional override for browser image URLs (defaults to MINIO_ENDPOINT/MINIO_BUCKET)
# MINIO_PUBLIC_BASE=http://127.0.0.1:9001/product-images

# Shop assistant (Google ADK + LiteLLM / Groq; model id must include groq/ prefix)
GROQ_API_KEY=
ASSISTANT_MODEL=groq/qwen/qwen3.8-27b
# Order tools: asgi = in-process (default); http = TCP to ASSISTANT_API_BASE_URL
# ASSISTANT_API_TRANSPORT=asgi
# ASSISTANT_API_BASE_URL=http://127.0.0.1:8000